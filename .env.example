# Required for production. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional; defaults to data/sam-hub.sqlite
DATABASE_PATH=data/sam-hub.sqlite

# Optional; defaults to 3001
PORT=3001

# Required in production; local development prints one-time links to the API terminal.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="SAM Barbing Hub <your-gmail-address@gmail.com>"
